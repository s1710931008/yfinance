name: Walk-forward backtest (parallel folds)

on:
  workflow_dispatch:
  schedule:
    - cron: '0 3 * * *'  # daily (adjust as needed)

jobs:
  setup:
    runs-on: ubuntu-latest
    outputs:
      requirements-hash: ${{ steps.hash.outputs.hash }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Hash requirements
        id: hash
        run: echo "::set-output name=hash::$(sha256sum requirements.txt | cut -d' ' -f1)"

  run-folds:
    needs: setup
    runs-on: ubuntu-latest
    strategy:
      matrix:
        fold: [0,1,2,3,4]     # 修改為你的 folds index 0..(N-1)
      max-parallel: 5
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      - name: Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ needs.setup.outputs.requirements-hash }}
      - name: Install dependencies
        run: python -m pip install -r requirements.txt
      - name: Run fold
        run: |
          mkdir -p outputs
          python ./scripts/run_fold.py 00631L.TW \
            --folds 5 --fold-index ${{ matrix.fold }} \
            --model extra-trees --feature-set all \
            --output outputs/result-fold-${{ matrix.fold }}.json
      - name: Upload fold result
        uses: actions/upload-artifact@v4
        with:
          name: result-fold-${{ matrix.fold }}
          path: outputs/result-fold-${{ matrix.fold }}.json

  aggregate:
    needs: run-folds
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Download all fold results
        uses: actions/download-artifact@v4
        with:
          path: ./artifacts
      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      - name: Install deps
        run: python -m pip install -r requirements.txt
      - name: Aggregate results
        run: |
          python ./scripts/aggregate_results.py --artifacts-dir ./artifacts --out ./report/summary.json
      - name: Upload report
        uses: actions/upload-artifact@v4
        with:
          name: backtest-report
          path: report/summary.json
